{
  "version": "2.0",
  "extensions": {
    "queues": {
      "messageEncoding": "base64",
      "visibilityTimeout": "00:00:05",
      "maxDequeueCount": 3
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  }
}
