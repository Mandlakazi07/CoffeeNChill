# Copy this file to .env (same folder as docker-compose.yml) and fill it in.
# .env is git-ignored. Never commit the real JWT key.

# Signing key for the gateway's JWTs. HMAC-SHA256 needs at least 32 characters.
# Generate one in PowerShell with:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# or on Linux with:
#   openssl rand -base64 48
JWT_KEY=

JWT_ISSUER=CoffeeNChillGateway
JWT_AUDIENCE=CoffeeNChillClients

# Docker Hub account the images are pulled from / pushed to.
DOCKERHUB_NAMESPACE=mandlakazi07
FUNCTIONS_TAG=part2
GATEWAY_TAG=part3

# Public port for the gateway (Swagger at http://<host>:<port>/swagger).
GATEWAY_PORT=5000
