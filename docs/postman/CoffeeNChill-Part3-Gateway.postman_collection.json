				{
					"name": "Login as Customer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Logs in the customer registered earlier and saves the JWT as {{customerToken}}.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const body = pm.response.json();",
									"",
									"pm.test(\"Response contains a token\", function () {",
									"    pm.expect(body.token).to.be.a(\"string\").and.not.be.empty;",
									"});",
									"",
									"pm.test(\"Token has Name, Email and Role claims\", function () {",
									"    const payload = body.token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
									"    const claims = JSON.parse(atob(payload));",
									"    pm.expect(claims.unique_name, \"name claim\").to.be.a(\"string\").and.not.be.empty;",
									"    pm.expect(claims.email, \"email claim\").to.eql(pm.collectionVariables.get(\"customerEmail\"));",
									"    pm.expect(claims.role, \"role claim\").to.eql(\"Customer\");",
									"});",
									"",
									"pm.collectionVariables.set(\"customerToken\", body.token);"
								]
							}
						}
					]
				},
