{
	"info": {
		"name": "CoffeeNChill Part 3 - API Gateway",
		"description": "Requests for the Part 3 ASP.NET Core gateway, including the JWT Bearer flows.\n\nRun the folders in order. Folder 00 creates unique test users for the run and folder 01 stores their tokens in collection variables (customerToken, staffToken, adminToken) that later requests use.\n\nPick the CoffeeNChill Part 3 environment and set baseUrl to the local Docker URL or the VPS URL. See docs/part3-docker-and-postman.md.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "noauth"
	},
	"variable": [
		{
			"key": "runId",
			"value": "",
			"type": "string"
		},
		{
			"key": "customerEmail",
			"value": "",
			"type": "string"
		},
		{
			"key": "staffEmail",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminEmail",
			"value": "",
			"type": "string"
		},
		{
			"key": "testPassword",
			"value": "",
			"type": "string"
		},
		{
			"key": "customerToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "staffToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "00 - Setup and health",
			"description": "Run first. Creates unique test emails for this run so the collection can be run again without 409 conflicts.",
			"item": [
				{
					"name": "Swagger document is reachable",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/swagger/v1/swagger.json",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"swagger",
								"v1",
								"swagger.json"
							]
						},
						"description": "Checks the gateway is up and Swagger/OpenAPI is being served.",
						"auth": {
							"type": "noauth"
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// New emails every run, so re-running the collection does not hit \"User already exists\".",
									"const runId = Date.now();",
									"pm.collectionVariables.set(\"runId\", runId);",
									"pm.collectionVariables.set(\"customerEmail\", \"customer.\" + runId + \"@coffeenchill.test\");",
									"pm.collectionVariables.set(\"staffEmail\", \"staff.\" + runId + \"@coffeenchill.test\");",
									"pm.collectionVariables.set(\"adminEmail\", \"admin.\" + runId + \"@coffeenchill.test\");",
									"if (!pm.collectionVariables.get(\"testPassword\")) {",
									"    pm.collectionVariables.set(\"testPassword\", \"Postman!\" + runId);",
									"}"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"OpenAPI document is for the CoffeeNChill gateway\", function () {",
									"    pm.expect(pm.response.json().info.title).to.eql(\"CoffeeNChill Gateway\");",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "01 - Auth: register and login",
			"description": "Registers one user per role, logs each in and stores the tokens used by the rest of the collection.",
			"item": [
				{
					"name": "Register Customer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Creates a Customer user in the Users table (PartitionKey = Customer, RowKey = email).",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"Postman Customer\",\n  \"role\": \"Customer\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Success message is returned\", function () {",
									"    pm.expect(pm.response.json().message).to.eql(\"User registered successfully.\");",
									"});"
								]
							}
						}
					]
				},
