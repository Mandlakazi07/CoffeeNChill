		{
			"name": "04 - Menu: Staff and Admin",
			"description": "Requires a Bearer token with the Staff or Admin role ([Authorize(Roles = \"Admin,Staff\")]).",
			"item": [
				{
					"name": "Add menu item (Staff token)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/menu",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"menu"
							]
						},
						"description": "The current gateway expects the body to be a plain JSON string, not an object.",
						"body": {
							"mode": "raw",
							"raw": "\"Flat White\"",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{staffToken}}",
									"type": "string"
								}
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
